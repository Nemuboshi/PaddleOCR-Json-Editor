    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
